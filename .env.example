# Application
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,.koyeb.app,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_METHODS=POST,GET,PUT,PATCH,OPTIONS,DELETE

# Base de données locale (SQLite par défaut)
TYPE_DATABASE=SQLITE
DATABASE_ENGINE=django.db.backends.sqlite3
DATABASE_NAME=db.sqlite3

# Base de données de production (PostgreSQL - Koyeb / Neon / Render)
# DATABASE_URL=postgresql://user:password@ep-xyz.region.koyeb.app:5432/todo?sslmode=require
